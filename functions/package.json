  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.1.0",
    "@typescript-eslint/parser": "^8.1.0",
    "eslint": "^9.9.0",
    "rimraf": "^6.0.1",
    "typescript": "^5.5.4",
    "jest": "^29",
    "ts-jest": "^29",
    "@types/jest": "^29",
    "firebase-functions-test": "^3",
    "@firebase/rules-unit-testing": "^4"
  }
