rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ─────────────────────────────────────────
    // Helper functions
    // ─────────────────────────────────────────

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return request.auth.uid == uid;
    }

    function getUserRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function isAdmin() {
      return isSignedIn() && getUserRole() == 'admin';
    }

    function isEmailVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    // ─────────────────────────────────────────
    // Users
    // ─────────────────────────────────────────

    match /users/{uid} {
      // Any signed-in user can read another user's basic profile (needed for PM marketplace).
      allow read: if isSignedIn();

      // Users can only write their own profile. Admins can write any profile.
      allow create: if isSignedIn() && isOwner(uid);
      allow update: if (isSignedIn() && isOwner(uid)) || isAdmin();
      allow delete: if isAdmin();
    }

    // ─────────────────────────────────────────
    // Projects
    // ─────────────────────────────────────────

    match /projects/{projectId} {
      function isProjectOwner() {
        return resource.data.ownerUid == request.auth.uid;
      }

      function isAssignedPm() {
        return resource.data.assignedPmUid == request.auth.uid;
      }

      function isProjectMember() {
        return isProjectOwner() || isAssignedPm() || isAdmin();
      }

      allow read: if isSignedIn() && isProjectMember();

      // Only verified users can create projects.
      allow create: if isEmailVerified()
        && request.resource.data.ownerUid == request.auth.uid;

      // Owner or PM can update; only owner can change the assignedPmUid.
      allow update: if isSignedIn() && isProjectMember();

      // Only owner (or admin) can delete a project.
      allow delete: if isSignedIn() && (isProjectOwner() || isAdmin());

      // ── Project sub-collections ──

      match /phases/{phaseId} {
        allow read: if isSignedIn() && isProjectMember();
        allow write: if isEmailVerified() && isProjectMember();
      }

      match /costs/{costId} {
        allow read: if isSignedIn() && isProjectMember();
        allow create: if isEmailVerified() && isProjectMember();
        // Cost entries are immutable after creation (edit by creating new one).
        allow update, delete: if isSignedIn() && isProjectOwner();
      }

      match /updates/{updateId} {
        allow read: if isSignedIn() && isProjectMember();
        allow create: if isEmailVerified() && isProjectMember();
        // Updates are immutable.
        allow update, delete: if isAdmin();
      }

      match /documents/{docId} {
        allow read: if isSignedIn() && isProjectMember();
        allow create: if isEmailVerified() && isProjectMember();
        // Only owner can delete documents.
        allow delete: if isSignedIn() && isProjectOwner();
        allow update: if isEmailVerified() && isProjectMember();
      }

      match /estimates/{estimateId} {
        allow read: if isSignedIn() && isProjectMember();
        allow write: if isEmailVerified() && isProjectMember();
      }
    }

    // ─────────────────────────────────────────
    // PM Profiles (public marketplace)
    // ─────────────────────────────────────────

    match /pm_profiles/{uid} {
      // Anyone signed in can browse PM profiles.
      allow read: if isSignedIn();

      // PMs manage their own profile. Admins can manage any.
      allow create: if isEmailVerified() && isOwner(uid);
      allow update: if isEmailVerified() && (isOwner(uid) || isAdmin());
      allow delete: if isAdmin();

      match /reviews/{reviewId} {
        allow read: if isSignedIn();
        // Verified owners can write a review (one per project enforced in app layer).
        allow create: if isEmailVerified();
        allow update, delete: if isAdmin();
      }
    }

    // ─────────────────────────────────────────
    // Vendors (any verified user can add/rate; only admin can delete)
    // ─────────────────────────────────────────

    match /vendors/{vendorId} {
      allow read: if isSignedIn();
      allow create: if isEmailVerified();
      // Allow update for ratings (ratingsCount / ratingsSum increment).
      allow update: if isEmailVerified();
      allow delete: if isAdmin();
    }

    // ─────────────────────────────────────────
    // Cost Catalog (admin publishes; public read — estimate page works unauthed)
    // ─────────────────────────────────────────

    match /cost_catalog/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ─────────────────────────────────────────
    // FX Rates (admin or server writes; public read)
    // ─────────────────────────────────────────

    match /fx_rates/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ─────────────────────────────────────────
    // Contracts
    // ─────────────────────────────────────────

    match /contracts/{contractId} {
      function isContractOwner() {
        return resource.data.ownerUid == request.auth.uid;
      }
      function isContractBuilder() {
        return resource.data.builderUid == request.auth.uid;
      }
      function isContractMember() {
        return isContractOwner() || isContractBuilder() || isAdmin();
      }

      // Owner and builder can read; admins can read all.
      allow read: if isSignedIn() && isContractMember();

      // Verified owners can create a contract.
      allow create: if isEmailVerified()
        && request.resource.data.ownerUid == request.auth.uid;

      // Builder can accept/decline (update status + signature fields).
      // Owner can cancel (update status).
      allow update: if isEmailVerified() && isContractMember();

      allow delete: if isAdmin();
    }

    // ─────────────────────────────────────────
    // Complaints (deferred — placeholder rules)
    // ─────────────────────────────────────────

    match /complaints/{complaintId} {
      // Users can read and delete their own complaints; admins can access all.
      allow read: if isSignedIn()
        && (resource.data.userUid == request.auth.uid || isAdmin());
      allow create: if isEmailVerified();
      allow update: if isAdmin();
      allow delete: if isSignedIn()
        && (resource.data.userUid == request.auth.uid || isAdmin());
    }

  }
}
