rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ─────────────────────────────────────────
    // Helper functions
    // ─────────────────────────────────────────

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return request.auth.uid == uid;
    }

    // Admin check via custom claim — set by Cloud Function onUserRoleChange.
    // Uses token claim instead of a Firestore document read for lower latency
    // and to avoid billable reads inside security rules.
    function isAdmin() {
      return isSignedIn() && request.auth.token.role == 'admin';
    }

    function isEmailVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    // Returns the user's active subscription tier from custom claims.
    function subTier() {
      return isSignedIn()
        ? request.auth.token.get('subscriptionTier', 'free')
        : 'free';
    }

    // True when user has at least Project Pass / Pro / Business.
    function isPaidUser() {
      return subTier() == 'project_pass'
          || subTier() == 'pro'
          || subTier() == 'business';
    }

    // ─────────────────────────────────────────
    // Users
    // ─────────────────────────────────────────

    match /users/{uid} {
      // Only the owner or an admin can read a user profile.
      // (Names/avatars needed elsewhere are denormalised into project/contract docs.)
      allow read: if isSignedIn() && (isOwner(uid) || isAdmin());
      allow create: if isSignedIn() && isOwner(uid);
      allow update: if (isSignedIn() && isOwner(uid)) || isAdmin();
      // Owner can delete their own account (via deleteAccount()); admins can too.
      allow delete: if (isSignedIn() && isOwner(uid)) || isAdmin();

      match /notifications/{notifId} {
        // Only the owner can read/write their own notifications.
        // Cloud Functions write here using Admin SDK (bypasses rules).
        allow read: if isSignedIn() && isOwner(uid);
        allow update: if isSignedIn() && isOwner(uid);
        allow delete: if isSignedIn() && isOwner(uid);
        allow create: if false; // written only by Cloud Functions
      }
    }

    // ─────────────────────────────────────────
    // Projects
    // ─────────────────────────────────────────

    match /projects/{projectId} {
      function isProjectOwner() {
        return resource.data.ownerUid == request.auth.uid;
      }

      function isAssignedPm() {
        return resource.data.assignedPmUid == request.auth.uid;
      }

      function isTeamMember() {
        return request.auth.uid in resource.data.teamMemberUids;
      }

      function isCollaborator() {
        return request.auth.uid in resource.data.collaboratorUids;
      }

      function isObserver() {
        return request.auth.uid in resource.data.observerUids;
      }

      function isProjectMember() {
        return isProjectOwner() || isAssignedPm() || isTeamMember() || isAdmin();
      }

      allow read: if isSignedIn() && isProjectMember();

      allow create: if isEmailVerified()
        && request.resource.data.ownerUid == request.auth.uid;

      allow update: if isSignedIn() && isProjectMember();

      allow delete: if isSignedIn() && (isProjectOwner() || isAdmin());

      // ── Project sub-collections ──

      match /phases/{phaseId} {
        allow read: if isSignedIn() && isProjectMember();
        allow write: if isEmailVerified() &&
          (isProjectOwner() || isAssignedPm() || isCollaborator() || isAdmin());
      }

      match /costs/{costId} {
        allow read: if isSignedIn() && isProjectMember();
        allow create: if isEmailVerified() &&
          (isProjectOwner() || isAssignedPm() || isCollaborator() || isAdmin());
        allow update, delete: if isSignedIn() && isProjectOwner();
      }

      match /updates/{updateId} {
        allow read: if isSignedIn() && isProjectMember();
        allow create: if isEmailVerified() && isProjectMember();
        allow update, delete: if isAdmin();
      }

      match /documents/{docId} {
        allow read: if isSignedIn() && isProjectMember();
        allow create: if isEmailVerified() && isProjectMember();
        allow delete: if isSignedIn() && isProjectOwner();
        allow update: if isEmailVerified() && isProjectMember();
      }

      match /estimates/{estimateId} {
        allow read: if isSignedIn() && isProjectMember();
        allow write: if isEmailVerified() && isProjectMember();
      }

      match /payments/{paymentId} {
        allow read: if isSignedIn() && isProjectMember();
        allow create: if isEmailVerified() && isProjectMember();
        allow delete: if isSignedIn() && (isProjectOwner() || isAdmin());
        allow update: if isAdmin();
      }

      match /deletionRequests/{itemId} {
        // Builder creates request; owner + admin can read + resolve
        allow read: if isSignedIn() && isProjectMember();
        allow create: if isEmailVerified() && isProjectMember();
        allow update: if isEmailVerified() && (isProjectOwner() || isAdmin());
        allow delete: if isAdmin();
      }

      match /chat/{messageId} {
        // Any project member can read and send messages.
        allow read: if isSignedIn() && isProjectMember();
        allow create: if isEmailVerified() && isProjectMember();
        // Messages are immutable once sent; only admin can delete.
        allow update: if false;
        allow delete: if isAdmin();
      }

      match /boq/{document=**} {
        allow read: if isSignedIn() && isProjectMember();
        allow write: if isEmailVerified() && isProjectMember();
      }

      match /due_diligence/{itemId} {
        allow read: if isSignedIn() && isProjectMember();
        // Owner seeds & updates status; Cloud Functions can write too.
        allow write: if isEmailVerified() && isProjectMember();
      }

      match /snag_items/{snagId} {
        allow read: if isSignedIn() && isProjectMember();
        allow create: if isEmailVerified() && isProjectMember();
        allow update: if isEmailVerified() && isProjectMember();
        allow delete: if isSignedIn() && (isProjectOwner() || isAdmin());
      }

      match /labor_records/{recordId} {
        allow read: if isSignedIn() && isProjectMember();
        allow create: if isEmailVerified() && isProjectMember();
        allow update: if isEmailVerified() && isProjectMember();
        allow delete: if isSignedIn() && (isProjectOwner() || isAdmin());
      }

      match /variation_orders/{voId} {
        // True when the VO amount exceeds 5% of project budget.
        function voRequiresCertification() {
          let budget = resource.data.get('projectBudgetGhs', 0);
          let amount = resource.data.get('costDeltaGhs', 0);
          return budget > 0 && (amount > budget * 0.05 || amount < -(budget * 0.05));
        }

        // Any project member can read change orders.
        allow read: if isSignedIn() && isProjectMember();
        // Builder submits; owner can update (approve/reject); PM can certify.
        allow create: if isEmailVerified() && isProjectMember();
        // Owner cannot approve a high-value VO that hasn't been certified by a PM.
        allow update: if isEmailVerified()
          && (isProjectOwner() || isAssignedPm() || isAdmin())
          && !(
            request.resource.data.status == 'approved'
            && voRequiresCertification()
            && resource.data.get('certifiedByUid', null) == null
          );
        allow delete: if isAdmin();
      }

      match /site_visits/{visitId} {
        // Any project member can read, create and update site visits.
        allow read: if isSignedIn() && isProjectMember();
        allow create: if isEmailVerified() && isProjectMember();
        allow update: if isEmailVerified() && isProjectMember();
        allow delete: if isSignedIn() && (isProjectOwner() || isAdmin());
      }

      match /tasks/{taskId} {
        allow read: if isSignedIn() && isProjectMember();
        allow create: if isEmailVerified() &&
          (isProjectOwner() || isAssignedPm() || isCollaborator() || isAdmin());
        allow update: if isEmailVerified() &&
          (isProjectOwner() || isAssignedPm() || isCollaborator() || isAdmin());
        allow delete: if isSignedIn() && (isProjectOwner() || isAdmin());

        match /comments/{commentId} {
          allow read: if isSignedIn() && isProjectMember();
          allow create: if isEmailVerified() && isProjectMember();
          allow update: if isEmailVerified() &&
            resource.data.authorUid == request.auth.uid;
          allow delete: if isSignedIn() && (
            resource.data.authorUid == request.auth.uid ||
            isProjectOwner() ||
            isAdmin()
          );
        }
      }

      match /risks/{riskId} {
        allow read: if isSignedIn() && isProjectMember();
        allow create: if isEmailVerified() && isProjectMember();
        allow update: if isEmailVerified() && isProjectMember();
        allow delete: if isSignedIn() && (isProjectOwner() || isAdmin());
      }

      match /land_ownership/{recordId} {
        // Only the project owner and admin can manage land ownership records.
        allow read: if isSignedIn() && isProjectMember();
        allow create: if isEmailVerified() && isProjectOwner();
        allow update: if isEmailVerified() && (isProjectOwner() || isAdmin());
        allow delete: if isSignedIn() && (isProjectOwner() || isAdmin());
      }

      match /audit_log/{logId} {
        allow read: if isSignedIn() && (
          isAdmin() ||
          resource.data.ownerUid == request.auth.uid ||
          resource.data.actorUid == request.auth.uid
        );
        allow create: if isEmailVerified() && isProjectMember();
        allow update, delete: if false;
      }
    }

    // ─────────────────────────────────────────
    // PM Profiles (public marketplace)
    // ─────────────────────────────────────────

    match /pm_profiles/{uid} {
      allow read: if isSignedIn();
      allow create: if isEmailVerified() && isOwner(uid);
      allow update: if isEmailVerified() && (isOwner(uid) || isAdmin());
      allow delete: if isAdmin();

      match /reviews/{reviewId} {
        allow read: if isSignedIn();
        allow create: if isEmailVerified();
        allow update, delete: if isAdmin();
      }

      match /portfolio/{docId} {
        allow read: if isSignedIn();
        allow write: if isOwner(uid) && isEmailVerified();
      }
    }

    // ─────────────────────────────────────────
    // Vendors
    // ─────────────────────────────────────────

    match /vendors/{vendorId} {
      allow read: if isSignedIn();
      allow create: if isEmailVerified();
      allow update: if isEmailVerified();
      allow delete: if isAdmin();
    }

    // ─────────────────────────────────────────
    // Cost Catalog (admin publishes; public read)
    // ─────────────────────────────────────────

    match /cost_catalog/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ─────────────────────────────────────────
    // FX Rates (public read)
    // ─────────────────────────────────────────

    match /fx_rates/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ─────────────────────────────────────────
    // BOQ Unit Rates (admin publishes; public read)
    // ─────────────────────────────────────────

    match /boq_rates/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ─────────────────────────────────────────
    // Contracts
    // Stored top-level so both owner and builder can query.
    // memberUids = [ownerUid, builderUid] — enables arrayContains queries
    // that Firestore can align with the security rule.
    // ─────────────────────────────────────────

    match /contracts/{contractId} {
      // read: aligned for arrayContains queries on memberUids,
      //       and also aligned for where('builderUid') queries (pendingForBuilder).
      allow read: if isSignedIn() && (
        request.auth.uid in resource.data.memberUids ||
        resource.data.builderUid == request.auth.uid
      );

      allow create: if isEmailVerified()
        && request.resource.data.ownerUid == request.auth.uid;

      allow update: if isEmailVerified() && (
        request.auth.uid in resource.data.memberUids ||
        resource.data.builderUid == request.auth.uid
      );

      allow delete: if isAdmin();
    }

    // ─────────────────────────────────────────
    // Audit Log (immutable once written)
    // ─────────────────────────────────────────

    match /audit_log/{eventId} {
      // Only the authenticated user can write audit events under their own uid.
      allow create: if isSignedIn()
        && request.resource.data.actorUid == request.auth.uid;
      // Reads use denormalised ownerUid/actorUid fields — no get() billable reads.
      allow read: if isSignedIn() && (
        isAdmin() ||
        resource.data.ownerUid == request.auth.uid ||
        resource.data.actorUid == request.auth.uid
      );
      // Audit events are immutable — no updates or deletes.
      allow update, delete: if false;
    }

    // ─────────────────────────────────────────
    // RFQ Requests
    // ─────────────────────────────────────────

    match /rfq_requests/{rfqId} {
      // Owner or vendor can read their own RFQs
      allow read: if isSignedIn() && (
        resource.data.ownerUid == request.auth.uid ||
        resource.data.vendorId == request.auth.uid
      );
      // Email-verified users can create (prevents spam from throwaway accounts)
      allow create: if isEmailVerified();
      // Vendor can respond; owner can accept or decline
      allow update: if isSignedIn() && (
        resource.data.vendorId == request.auth.uid ||
        resource.data.ownerUid == request.auth.uid
      );
      allow delete: if isAdmin();
    }

    // ─────────────────────────────────────────
    // Project Templates (owner-private)
    // ─────────────────────────────────────────

    match /project_templates/{templateId} {
      allow read: if isSignedIn()
        && resource.data.ownerUid == request.auth.uid;
      allow create: if isEmailVerified()
        && request.resource.data.ownerUid == request.auth.uid;
      allow delete: if isSignedIn()
        && resource.data.ownerUid == request.auth.uid;
      allow update: if false; // templates are immutable
    }

    // ─────────────────────────────────────────
    // Complaints
    // ─────────────────────────────────────────

    match /complaints/{complaintId} {
      allow read: if isSignedIn()
        && (resource.data.userUid == request.auth.uid || isAdmin());
      allow create: if isEmailVerified();
      allow update: if isAdmin();
      allow delete: if isSignedIn()
        && (resource.data.userUid == request.auth.uid || isAdmin());
    }

    // ─────────────────────────────────────────
    // ID Verification (per-user sub-collection)
    // ─────────────────────────────────────────

    match /users/{uid}/id_verification/{docId} {
      allow read: if isOwner(uid) || isAdmin();
      allow create, update: if isOwner(uid) && isEmailVerified();
    }

    // ─────────────────────────────────────────
    // Login Activity (per-user sub-collection)
    // ─────────────────────────────────────────

    match /users/{uid}/login_activity/{docId} {
      allow read: if isOwner(uid) || isAdmin();
      allow create: if isOwner(uid);
    }

    // ─────────────────────────────────────────
    // Work History (builder sub-collection)
    // ─────────────────────────────────────────

    match /builder_profiles/{uid}/work_history/{docId} {
      allow read: if isSignedIn();
      allow write: if isOwner(uid) && isEmailVerified();
    }

    // ─────────────────────────────────────────
    // Certifications (builder sub-collection)
    // ─────────────────────────────────────────

    match /builder_profiles/{uid}/certifications/{docId} {
      allow read: if isSignedIn();
      allow write: if (isOwner(uid) && isEmailVerified()) || isAdmin();
    }

    // ─────────────────────────────────────────
    // Project Invitations
    // ─────────────────────────────────────────

    match /invitations/{token} {
      allow read: if isSignedIn() && (
        resource.data.inviteeEmail == request.auth.token.email ||
        resource.data.inviterUid == request.auth.uid ||
        isAdmin()
      );
      allow create: if isEmailVerified();
      allow update: if isSignedIn() && (
        resource.data.inviteeEmail == request.auth.token.email ||
        resource.data.inviterUid == request.auth.uid ||
        isAdmin()
      );
      allow delete: if isAdmin();
    }

  }
}
